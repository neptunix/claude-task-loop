# Task Loop Configuration
# Copy this file to your project root as .task-loop.env and customize.
# All values can be overridden via environment variables.

# REQUIRED: Human-readable name for this task loop
TASK_NAME="{{TASK_NAME}}"

# ─── File paths (relative to project root) ───────────────────────────────────
# PROMPT_FILE="TASK_PROMPT.md"        # Instructions Claude follows each iteration
# PROGRESS_FILE="TASK_PROGRESS.md"    # Checkbox queue of work items
# BLOCKERS_FILE="BLOCKERS.md"         # Blockers file (STOP halts the loop)

# ─── Sentinels ────────────────────────────────────────────────────────────────
# COMPLETION_SENTINEL="ALL_TASKS_COMPLETE"  # Line in progress file = done
# STOP_SENTINEL="STOP"                      # Line in blockers file = halt

# ─── Directories ──────────────────────────────────────────────────────────────
# OUTPUT_DIR="."                # Where task output files go
# LOG_DIR=".task-logs"          # Where iteration logs go

# ─── Limits ───────────────────────────────────────────────────────────────────
# MAX_ITERATIONS=50             # Maximum loop iterations
# TIMEOUT=1800                  # Seconds per iteration (30 min)
# SLEEP_BETWEEN=10              # Seconds between iterations

# ─── Git behavior ─────────────────────────────────────────────────────────────
# GIT_STASH=true                # Auto-stash uncommitted changes before each iteration
# GIT_COMMIT_CHECK=true         # Warn if Claude didn't commit during an iteration

# ─── Advanced ─────────────────────────────────────────────────────────────────
# SYSTEM_PROMPT_APPEND=""       # Extra text appended to Claude's system prompt
